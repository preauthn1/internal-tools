# Telegram 伺服器的設定範本（#3）
# 複製成 .env 再填值：cp .env.example .env
# .env 已列入 .gitignore；token 和 secret 不要 commit，也不要貼到 issue、MR 或日誌
# 啟動前載入：set -a; source .env; set +a

# 必填：BotFather 給的 token（格式像 123456789:AAAA...）
TELEGRAM_BOT_TOKEN=

# 必填：webhook 的 secret，自己產生的亂數，只能用英數字、_、-，最多 256 個字
# 產生方式：openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# 必填：Cloudflare Tunnel 的對外網址，要用 https:// 開頭，不用加路徑
# webhook 會自動設成 <這個網址>/telegram/webhook
#
# 開發時可以先用臨時 tunnel（quick tunnel），不需要 Cloudflare 帳號和網域：
#   1. 安裝：brew install cloudflared
#   2. 另開一個終端機執行（port 要和下面的 PORT 一樣）：
#        cloudflared tunnel --url http://localhost:8080
#   3. 輸出裡會有一行 https://<隨機名稱>.example.invalid，把它填到這裡
#   4. 載入 .env、啟動伺服器；伺服器啟動時會自動呼叫 setWebhook
# 注意：
#   - 臨時 tunnel 每次重開網址都會變，要改這裡的值並重啟伺服器（webhook 才會換成新網址）
#   - 只適合開發測試，沒有穩定性保證；測試機和正式版要改用綁網域的固定 tunnel（#12）
TELEGRAM_PUBLIC_URL=https://

# 選填：店員群組的 chat ID（群組通常是負數，例如 -1001234567890）
# 目前只記錄群組訊息、還不處理；店員群組的功能在 #11
TELEGRAM_STAFF_CHAT_ID=

# 選填：伺服器只聽 0.0.0.0，對外由 cloudflared 轉進來；預設 8080
# cloudflared 的 Tunnel 設定要指到 http://localhost:<這個 port>
PORT=8080

# 選填：店家設定檔（store.json、faq.txt、replies.json、examples.jsonl）所在的資料夾
# 沒設時用編譯時專案的 eval/，只適合開發機；執行檔搬到別的資料夾或部署到測試機時一定要設
# 啟動時會驗證設定檔，有錯會印出哪個檔案、哪裡錯後結束
BOT_CONFIG_DIR=

# 選填：SQLite 資料庫檔案；沒設時用「工作目錄」底下的 data/bot.sqlite
# 用 launchd 執行時要設這個，或設 launchd 的 WorkingDirectory
BOT_DB=

# 選填（Go 版）：後台的 port，只聽 0.0.0.0；預設 8081
# 對外用另一個 hostname，cloudflared 的 ingress 指到 http://localhost:<這個 port>，前面加 Cloudflare Access（見 README「後台」）
BOT_ADMIN_PORT=8081

# 選填（Go 版）：建好的後台前端（cd web && corepack pnpm build:antd 的輸出）
# 沒設時用「工作目錄」底下的 web/apps/web-antd/dist；不在 repo 根目錄啟動時要設成絕對路徑
BOT_ADMIN_DIR=

# 選填（Go 版）：題庫資料夾，後台新增意圖案例時檢查不能和題庫重複；讀不到時拒絕存檔
# 沒設時用「工作目錄」底下的 eval；不在 repo 根目錄啟動時要設成絕對路徑
BOT_EVAL_DIR=

# 選填（Go 版）：AI 模型。預設是 Apple 本機模型（afm，要有常駐的 model-server，見 README）
# 後台「模型設定」存過之後以後台為準，這裡只是第一次啟動的初始值
BOT_MODEL=afm

# 選填（Go 版）：Anthropic 的 API key（格式像 sk-ant-...），用 Haiku 時必填
# BOT_MODEL=haiku 卻沒有 key 時啟動失敗；後台切到 Haiku 但沒有 key 時記警告、照用本機模型
# 量測：python3 eval/verify.py --model haiku 也讀這個（先 set -a; source .env; set +a）
ANTHROPIC_API_KEY=

# 選填（Go 版）：Haiku 的模型名稱；沒設時用 claude-haiku-5-5
BOT_HAIKU_MODEL=

# 選填（Go 版）：每月 AI 費用上限（美元，0 表示不限）；沒設時 10。Haiku 費用到上限時自動切回本機模型、通知員工群組
# 後台「模型設定」存過之後以後台為準
BOT_AI_MONTHLY_BUDGET_USD=

# 選填（Go 版）：Apple 本機模型服務（model-server）的網址；沒設時 http://0.0.0.0:8765
BOT_APPLE_MODEL_URL=
