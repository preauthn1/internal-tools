# 端口号
VITE_PORT=5666

VITE_APP_TITLE=aichatbot 後台
VITE_APP_NAMESPACE=aichatbot-admin

VITE_BASE=/

# 後台 API：vite.config.ts 把 /api 轉到 Go 的後台伺服器（0.0.0.0:8081）
VITE_GLOB_API_URL=/api

VITE_ROUTER_HISTORY=history

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭
VITE_NITRO_MOCK=false

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true
