# 不放 .env：repo 根目錄的 .gitignore 擋掉 .env（那是機器人的密鑰）
VITE_APP_TITLE=aichatbot 後台
VITE_APP_NAMESPACE=aichatbot-admin

VITE_BASE=/

# 後台 API（Go 的後台伺服器，同一個網址）
VITE_GLOB_API_URL=/api

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式：Go 找不到的非 API 路徑都回 index.html
VITE_ROUTER_HISTORY=history

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=false
