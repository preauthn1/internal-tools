{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",


  "ConnectionStrings": {

  },

  "SlackNotify": {

    "NotifyChannel_When_SystemException": "n_error_public",
    "IsNotifyEnable_When_SystemException": true
  },



  "MinioApiEndPoint": "0.0.0.0:9000",
  "MinioApiBucket": "{{ .Values.appsettings.minio.bucket }}",
  "MinioApiAccessKey": "minio",
  "MinioApiSecretKey": "minio123",
  "MinioImageUrl": "http://0.0.0.0:9000",


  "ApiRequestLogTableName": "[dbo].[ApiRequestLogExternalVendorAPI]",
  "ApiRequestErrorLogTableName": "[dbo].[ApiRequestLogExternalVendorAPIError]",
  "Env": "{{ .Values.appsettings.env }}",
  "WebSiteName": "target.API.FileAPI.{{ .Values.appsettings.env }}",
  "WebHostListenPort": 3107,
  "IsEnableCache": true
}