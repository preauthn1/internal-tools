{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "MasterDB": "Server=0.0.0.0;Initial Catalog=PGS_Master;Persist Security Info=False;User ID=backend;Password=[REDACTED];MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;",
    "TransactionDB": "Server=0.0.0.0;Initial Catalog=PGS_Transaction;Persist Security Info=False;User ID=backend;Password=[REDACTED];MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;",
    "SystemLogDB": "Server=0.0.0.0;Initial Catalog=PGS_SystemLog;Persist Security Info=False;User ID=backend;Password=[REDACTED];MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;"
  },

  "SlackNotify": {

    "NotifyChannel_When_SystemException": "n_error_public",
    "IsNotifyEnable_When_SystemException": true
  },

  "ThirdParty": {

    "RedisConn": "0.0.0.0:6379,abortConnect=False",
    "RedisDBNumber": 1
  },

  "ApiRequestLogTableName": "[dbo].[ApiRequestLogPublicAPI]",
  "ApiRequestErrorLogTableName": "[dbo].[ApiRequestLogPublicAPIError]",
  "Env": "Dev",
  "WebSiteName": "target.Job.Console.Local",
  "WebHostListenPort": 3109,
  "Slot88MD5ExpiredMinutes": 10080,
  "IsEnableCache": true,
  "IsRemoteCache": true

}
