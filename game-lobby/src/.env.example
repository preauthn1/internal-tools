APP_NAME="Game Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://game-lobby.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,database
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# DB 日誌保留天數（每日 model:prune 依此清理 logs 資料表）
LOG_DATABASE_RETENTION_DAYS=30

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=developr_exam
DB_USERNAME=exam
DB_PASSWORD=

[REDACTED]
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=0.0.0.0

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=[REDACTED]
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=0.0.0.0
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=[REDACTED]
MAIL_FROM_ADDRESS="user@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
[REDACTED]
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── 遊戲平台設定 ──
GAME_INITIAL_BALANCE=10000
GAME_DEFAULT_PROVIDER=target

# ── target 遊戲商對接（轉帳模式）──
PGS_MERCHANT_ID=
PGS_MERCHANT_SECRET=
[REDACTED]
PGS_LOCALE=zh-cn
PGS_TIMEOUT=10
PGS_GAMES_CACHE_TTL=300
PGS_INVALID_STATE_CODES=403601
PGS_RECORDS_WINDOW=60
PGS_RECORDS_LOOKBACK=120
PGS_RECORDS_PAGE_SIZE=200
PGS_AUDIT_DELAY_MINUTES=30
PGS_AUDIT_RETRY_MINUTES=5
PGS_AUDIT_REVIEW_AFTER_MINUTES=120
PGS_AUDIT_MAX_ATTEMPTS=24
