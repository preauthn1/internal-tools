{
    "name": "internel/olympus-hub",
    "description": "The divine dashboard for multiple production realms. Command your connections through the Oracle UI.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Rhys",
            "email": "user@example.invalid"
        }
    ],
    "require": {
        "php": ">=7.1",
        "illuminate/support": "^5.5|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "friendsofphp/consul-php-sdk": "^5.3"
    },
    "require-dev": {
        "orchestra/testbench": "^3.5|^8.0|^9.0",
        "phpunit/phpunit": "^6.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "OlympusHub\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OlympusHub\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OlympusHub\\OlympusHubServiceProvider"
            ]
        }
    }
}
