@{
    ViewData["Title"] = "";
}


<div id="app">

    <h4>
        修改密码
    </h4>


    <div class="card search-form-card">



        <div style="width: 400px;">


            <div>
                <div class='form-label'>
                    <label>原密码</label>
                </div>

                <div>
                    <input type='password' class='form-control' v-model='editForm.oldPassword' placeHolder='' />
                </div>
            </div>


            <div>
                <div class='form-label'>
                    <label>新密码</label>
                </div>

                <div>
                    <input type='password' class='form-control' v-model='editForm.newPassword' placeHolder='' />
                </div>
            </div>


            <div>
                <div class='form-label'>
                    <label>确认密码</label>
                </div>

                <div>
                    <input type='password' class='form-control' v-model='editForm.confirmPassword' placeHolder='' />
                </div>
            </div>



        </div>


        <div style="padding:20px 0px;">
            <button type="button" class="mt-1 btn btn-red2" style="width:150px;" v-on:click="save">
                送出
            </button>
        </div>


    </div>





</div>



@section Scripts{


    <script>


        $(function () {


        })


        var app = new Vue({
            el: '#app',
            mixins: [global_mixin],
            data: {
                editForm: {
                }     
            },

            methods: {


                save() {

                    let vm = this;


                    let url = window.API_DOMAIN + '/users/self-password';
                    ajaxHelper.put(url, this.editForm)
                        .then((res) => {
                            vm.successAlert();
                            this.editForm = {};
                            console.log(vm.data);
                        })
                        .catch((error) => {
                            alert(error.data.message);
                            console.error(error)
                        })
                        .finally(() => {        
                        });

                }


            },

            mounted() {
               
                let vm = this;
            }
        })


    </script>

}
