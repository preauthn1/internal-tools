@{
    ViewData["Title"] = PermissionHelper.GetCurrentPageTile();
}


<div id="app">

    <h4>
        @PermissionHelper.GetCurrentPageTile()
    </h4>

    <div class="card search-form-card">


        <div class="row search-form">


            <div class="col-md-3">

                <label for="" class="">@t.Text(i18nKeys.Common_Label_Merchant)</label>

                <select class="form-control" v-model="dataTable.searchForm.merchantID">
                    <option value="">@t.Text(i18nKeys.Common_Label_FilterAll)</option>
                    <option v-for="(item , index) in dropdown.merchants" :value="item.value">
                        {{item.text}}
                    </option>
                </select>

            </div>


            <div class="col-md-3">
                <label for="createtime" class="">@t.Text(i18nKeys.Common_Label_CreateTime)</label>
                <input type="text" name="createtime" id="createtime" placeholder="@t.Text(i18nKeys.Common_Msg_FilterTimeRange)" class="form-control" v-model="dataTable.searchForm.createTime_displayText">
            </div>

            <div class="col-md-3">
                <div class="search-btn-row">
                    <button class="btn btn-alternate" v-on:click="getList(1)"> @t.Text(i18nKeys.Common_Button_Search)</button>
                    <button class="btn btn-secondary" v-on:click="resetForm"> @t.Text(i18nKeys.Common_Button_Reset)</button>
                </div>
            </div>


            <div style="clear:both;"></div>


        </div>



    </div>

    <div>
        @Html.Partial("DataTable")
    </div>


</div>



@section Scripts{


    <script>



        $(function () {



        })


        var app = new Vue({
            el: '#app',
            mixins: [global_mixin],
            data: {
                detailInfo: {},
                dataTable: {

                    getData: function () {
                        app.getList();
                    },
                    searchForm: {
                        merchantID: '',
                        merchantCode: '',
                        createTime_displayText: '',
                        createTimeBegin: '',
                        createTimeEnd: ''
                    },
                    pagination: {
                        items: [],
                        pageSize: 10,
                        orderByColumn: "Id",
                    },
                    columns:
                        [
                            { text: "@t.Text(i18nKeys.Common_Label_SystemID)", column: "id" },
                            { text: "@t.Text(i18nKeys.Common_Label_Merchant)", column: "merchantName" },
                            { text: "@t.Text(i18nKeys.Common_Label_Type)", column: "transactionTypeText" },
                            { text: "訂單金額", column: "sourceAmount", align: "r", isMoneyFormat : true },
                            { text: "手續費比例", column: "feeRate", align: "r", isMoneyFormat: true},
                            { text: "手續費", column: "fee", align: "r", isMoneyFormat: true },
                            {
                                text: "更新金額", column: "updateAmount", align: "r", 
                                "html": function (row) {
                                    let cssClass = row.updateAmount < 0 ? "minus_red" : "";
                                    return "<div class='" + cssClass +"'>" + format_helper.toMoneyDisplayFormat(row.updateAmount) + "</div>";
                                }
                            },
                            { text: "異動前金額", column: "beforeAmount", align: "r", isMoneyFormat: true },
                            { text: "異動後金額", column: "afterAmount", align: "r", isMoneyFormat: true },
                            {
                                text: "@t.Text(i18nKeys.Common_Label_CreateTime)", column: "createTime",
                                "html": function (row) {
                                    return format_helper.to_display_time(row.createTime);
                                }
                            },
                            {
                                text: "@t.Text(i18nKeys.Common_Label_OperateFunction)", column: "text", width: "10%", templates: []
                            }
                        ]
                }

            },

            methods: {

                getList(targetPageIndex) {

                    let vm = this;

                    //如果有指定頁數
                    if (targetPageIndex) {
                        this.dataTable.pagination.pageIndex = 1;
                    }

                    var queryString = form_helper.getSearchFormQueryString(this.dataTable);

                    let url = window.API_DOMAIN + '/records/merchant/wallet-logs';

                    ajaxHelper.get(url + queryString)
                        .then((res) => {
                            vm.dataTable.pagination = res.data.data;
                        })
                        .catch((error) => { console.log(error) })
                        .finally(() => { /* 不論失敗成功皆會執行 */ });

                }

            },

            mounted() {

                this.getList();

                this.getDropdownMerchants();

                let vm = this;

                date_picker.datetime_range_empty(
                    {
                        vue_instance: vm.dataTable.searchForm,
                        element_ID: "#createtime",
                        vue_prop_begin: "createTimeBegin",
                        vue_prop_end: "createTimeEnd",
                        vue_prop_text: "createTime_displayText"
                    });
            }
        })


    </script>

}